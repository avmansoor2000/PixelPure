# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Public origin, used for sitemap.xml / robots.txt (e.g. https://pixelpure.app)
PUBLIC_URL=
# Set to true when running behind a reverse proxy / load balancer (correct client IPs for rate limiting)
TRUST_PROXY=false

# ─── AI providers (server-side only — never exposed to the browser) ──
# Set at least one key. With INPAINT_PROVIDER/ENHANCE_PROVIDER=auto the first configured
# provider is used in this order: stability → clipdrop → replicate.
INPAINT_PROVIDER=auto        # auto | stability | clipdrop | replicate | local
ENHANCE_PROVIDER=auto        # auto | stability | clipdrop | replicate | local

# Stability AI — https://platform.stability.ai  (erase + fast/conservative upscale)
STABILITY_API_KEY=

# Clipdrop — https://clipdrop.co/apis  (cleanup + image-upscaling)
CLIPDROP_API_KEY=

# Replicate — https://replicate.com  (LaMa inpainting + Real-ESRGAN)
REPLICATE_API_TOKEN=
REPLICATE_INPAINT_MODEL=allenhooo/lama
REPLICATE_INPAINT_VERSION=       # optional: pin a version id; blank = latest
REPLICATE_UPSCALE_MODEL=nightmareai/real-esrgan
REPLICATE_UPSCALE_VERSION=

# If no AI key is configured, fall back to the built-in classical (non-AI) engine.
# Set to false in production to refuse requests instead.
ALLOW_LOCAL_FALLBACK=true
PROVIDER_TIMEOUT_MS=120000
MAX_CONCURRENT_JOBS=3

# ─── Limits ───────────────────────────────────────────────
MAX_FILE_MB=15
MAX_INPUT_MEGAPIXELS=40
MAX_FILES_PER_REQUEST=10
OUTPUT_MAX_SIDE=8192
OUTPUT_MAX_MEGAPIXELS=50
RATE_LIMIT_UPLOADS_PER_MIN=30
RATE_LIMIT_PROCESS_PER_MIN=12

# ─── Storage & cleanup ────────────────────────────────────
STORAGE_DIR=./storage
FILE_TTL_MINUTES=60
CLEANUP_INTERVAL_MINUTES=5
